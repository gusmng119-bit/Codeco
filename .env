# Set to false for pure Backend data, or true for local fallback mode
VITE_USE_LOCAL_FALLBACK=true

# Set your backend API base URL (e.g. https://api.yourdomain.com or http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to true to bypass login check completely on startup
VITE_BYPASS_LOGIN=false

# Role yang dipakai saat bypass login (siswa | guru | admin)
VITE_BYPASS_LOGIN_ROLE=siswa

# Set to true to accept any email/password during mock login test
# (role yang diassign = VITE_BYPASS_LOGIN_ROLE)
VITE_BYPASS_VALIDATION=false

# -------------------------------------------------------
# MOCK USERS (USE_LOCAL_FALLBACK=true, BYPASS_VALIDATION=false)
# -------------------------------------------------------
# siswa@codeco.com  / password123  → role: siswa  → /student
# guru@codeco.com   / password123  → role: guru   → /teacher
# admin@codeco.com  / password123  → role: admin  → /admin
