# Set to false for pure Backend data, or true for local fallback mode
VITE_USE_LOCAL_FALLBACK=true

# Set your backend API base URL (e.g. https://api.yourdomain.com or http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to true to bypass login check completely on startup
VITE_BYPASS_LOGIN=false

# Set to true to accept any email/password during mock login test
VITE_BYPASS_VALIDATION=false

# Mock credentials for validation testing (used when VITE_BYPASS_VALIDATION=false)
VITE_MOCK_USER_EMAIL=student@codeco.com
VITE_MOCK_USER_PASSWORD=password123
