# Set to false for pure Backend data, or true for local fallback mode
VITE_USE_LOCAL_FALLBACK=false

# Set your backend API base URL (e.g. https://api.yourdomain.com or http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to true to bypass login and auto-generate access token
VITE_BYPASS_LOGIN=true
